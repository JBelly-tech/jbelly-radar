# Generated by scripts/sync.ps1 — never committed, always reproducible.
# The exception is data/ledger.json, a few lines below: it records when this
# radar FIRST SAW each item, which no later run can reconstruct, so it is the
# one thing here that is committed. Git is then the off-machine, dated backup.
data/trends.json
data/trends.js
data/taxonomy.js
data/history/
!data/ledger.json

# data/index.json is PUBLISHED, not generated-and-forgotten: the agent skill in
# skills/ fetches it from this repository over raw.githubusercontent, so it has
# to be here. Built by scripts/build-index.ps1 from the ledger.
!data/index.json
data/status.json
data/*.tmp

# local overrides
config/sources.local.json
.env

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vs/
.idea/
*.swp
data/sync.lock

# Briefs are regenerated from the taxonomy plus a dated trends.json by
# scripts/brief.ps1. A brief you have actually SENT is a different thing — move
# it out of this folder and commit it, because a sent claim needs a record.
content/briefs/

# generated reports: reproducible from a plan plus the ledger
content/matches/

# content/examples/ is deliberately NOT ignored. Both features above write to
# ignored folders, so a fresh clone showed no sign either existed — you had to
# run them to find out what they produce. One dated sample of each is committed
# instead. They do not go stale: a brief freezes its citations at write time, so
# it is a record of one day, not a view that rots.

# demo bundles built by scripts/pack-demo.ps1, and the staged Pages site
dist/

# launch copy: for the owner to send, not part of the published project
content/launch/
