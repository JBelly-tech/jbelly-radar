# Generated by scripts/sync.ps1 — never committed, always reproducible.
# The exception is data/ledger.json, a few lines below: it records when this
# radar FIRST SAW each item, which no later run can reconstruct, so it is the
# one thing here that is committed. Git is then the off-machine, dated backup.
data/trends.json
data/trends.js
data/taxonomy.js
data/history/
!data/ledger.json
data/status.json
data/*.tmp

# local overrides
config/sources.local.json
.env

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vs/
.idea/
*.swp
data/sync.lock

# Briefs are regenerated from the taxonomy plus a dated trends.json by
# scripts/brief.ps1. A brief you have actually SENT is a different thing — move
# it out of this folder and commit it, because a sent claim needs a record.
content/briefs/
