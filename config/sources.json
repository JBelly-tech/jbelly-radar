  "heat": {
    "$comment": "Deterministic ranking, no model call. halfLifeDays: how fast an item cools. metricCeiling: the value that counts as saturated popularity. minBaselineHours: a metric baseline is only replaced once it is this old, so momentum is never invented from two syncs minutes apart.",
    "weights": {
      "recency": 0.4,
      "popularity": 0.35,
      "momentum": 0.25
    },
    "categories": {
      "skill": {
        "halfLifeDays": 14,
        "metricCeiling": 500000
      },
      "repo": {
        "halfLifeDays": 21,
        "metricCeiling": 20000
      },
      "news": {
        "halfLifeDays": 3,
        "metricCeiling": 1
      },
      "discussion": {
        "halfLifeDays": 5,
        "metricCeiling": 800
      },
      "research": {
        "halfLifeDays": 7,
        "metricCeiling": 1
      }
    },
    "minBaselineHours": 12
  }
