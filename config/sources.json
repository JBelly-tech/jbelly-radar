{
  "version": 1,
  "$comment": "Add a source = add an object here. No code change as long as 'kind' is one of: skills-sh | github-search | hn | rss. See README.md > Adding a source.",
  "defaults": {
    "timeoutSec": 30,
    "maxItems": 25,
    "userAgent": "jbelly-radar/1.0 (local research dashboard)",
    "$filters": "Per-source 'requireMatch' / 'excludeMatch' are .NET regexes tested against title + summary. They are the config-side filter, so a noisy feed never needs a code change."
  },
  "sources": [
    {
      "id": "skills-sh",
      "label": "skills.sh leaderboard",
      "kind": "skills-sh",
      "category": "skill",
      "enabled": true,
      "url": "https://www.skills.sh/",
      "maxItems": 120,
      "weeklyOrder": "newest-first"
    },
    {
      "id": "gh-claude-skills",
      "label": "GitHub · new skill repos",
      "kind": "github-search",
      "category": "skill",
      "enabled": true,
      "query": "topic:claude-skill",
      "createdWithinDays": 120,
      "sort": "stars",
      "maxItems": 20
    },
    {
      "id": "gh-agent-skills",
      "label": "GitHub · agent-skills topic",
      "kind": "github-search",
      "category": "skill",
      "enabled": true,
      "query": "topic:agent-skills",
      "createdWithinDays": 180,
      "sort": "stars",
      "maxItems": 15
    },
    {
      "id": "gh-mcp-servers",
      "label": "GitHub · new MCP servers",
      "kind": "github-search",
      "category": "repo",
      "enabled": true,
      "query": "topic:mcp-server",
      "createdWithinDays": 60,
      "sort": "stars",
      "maxItems": 20
    },
    {
      "id": "gh-ai-rising",
      "label": "GitHub · rising AI repos",
      "kind": "github-search",
      "category": "repo",
      "enabled": true,
      "query": "topic:ai stars:>150",
      "createdWithinDays": 90,
      "sort": "stars",
      "maxItems": 25
    },
    {
      "id": "gh-agent-frameworks",
      "label": "GitHub · agent frameworks",
      "kind": "github-search",
      "category": "repo",
      "enabled": true,
      "query": "\"ai agent\" in:name,description stars:>300",
      "pushedWithinDays": 21,
      "sort": "updated",
      "maxItems": 20
    },
    {
      "id": "hn-ai-agents",
      "label": "Hacker News · AI agents",
      "kind": "hn",
      "category": "discussion",
      "enabled": true,
      "query": "AI agent",
      "minPoints": 80,
      "withinDays": 21,
      "maxItems": 20
    },
    {
      "id": "hn-vibe-coding",
      "label": "Hacker News · vibe coding",
      "kind": "hn",
      "category": "discussion",
      "enabled": true,
      "query": "vibe coding",
      "minPoints": 40,
      "withinDays": 45,
      "maxItems": 20
    },
    {
      "id": "hn-coding-agents",
      "label": "Hacker News · coding agents",
      "kind": "hn",
      "category": "discussion",
      "enabled": true,
      "query": "coding agent",
      "minPoints": 60,
      "withinDays": 30,
      "maxItems": 20
    },
    {
      "id": "hn-claude-code",
      "label": "Hacker News · Claude Code",
      "kind": "hn",
      "category": "discussion",
      "enabled": true,
      "query": "claude code",
      "minPoints": 40,
      "withinDays": 45,
      "maxItems": 15
    },
    {
      "id": "forbes-innovation",
      "label": "Forbes · Innovation",
      "kind": "rss",
      "category": "news",
      "enabled": true,
      "url": "https://www.forbes.com/innovation/feed2/",
      "maxItems": 20,
      "excludeMatch": "(?i)(connections hints|wordle|quordle|strands hints|mini crossword|horoscope|nyt games|today's .* answers|super bowl|nfl|nba|box office)",
      "requireMatch": "(?i)\\b(ai|a\\.i\\.|artificial intelligence|llm|llms|agent|agents|agentic|openai|anthropic|claude|gemini|copilot|chatgpt|model|models|robot|robotics|chip|chips|nvidia|gpu|data cent|machine learning|neural|automation|developer|software|startup|cloud|quantum|coding)\\b"
